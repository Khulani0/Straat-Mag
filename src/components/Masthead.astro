---
import { ISSUE_NUMBER, ISSUE_DATE, SECTIONS } from '../consts';

const currentPath = Astro.url.pathname;
---

<header class="masthead">
  <div class="wrap mast-top">
    <a class="wordmark" href="/" aria-label="Straatpreneur home">STRAAT<span class="mag">PRENEUR</span></a>
    <p class="issue-line">Issue {ISSUE_NUMBER} · {ISSUE_DATE}</p>
  </div>
  <nav class="wrap mast-nav" aria-label="Sections">
    {
      SECTIONS.map((s) => (
        <a
          href={`/section/${s.slug}`}
          aria-current={currentPath === `/section/${s.slug}` ? 'page' : undefined}
        >
          {s.name}
        </a>
      ))
    }
    <a href="/about" aria-current={currentPath === '/about' ? 'page' : undefined}>About</a>
    <a
      class="nav-subscribe"
      href="/subscribe"
      aria-current={currentPath === '/subscribe' ? 'page' : undefined}
    >
      Subscribe
    </a>
  </nav>
</header>
