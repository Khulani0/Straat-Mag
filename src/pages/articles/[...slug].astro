---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MoneyLine from '../../components/MoneyLine.astro';
import { sectionBySlug, isVisible } from '../../consts';

export async function getStaticPaths() {
  const articles = await getCollection('articles', (a) => isVisible(a.data));
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

import credits from '../../../data/image-credits.json';

const { article } = Astro.props;
const { Content } = await render(article);
const section = sectionBySlug(article.data.section);
const heroFor = (a) => a.data.heroImage ?? a.data.heroSvg ?? `/heroes/${a.id}.svg`;
const credit = (credits as Record<string, { provider: string; photographer: string; pageUrl: string }>)[article.id];
const dateLabel = article.data.date.toLocaleDateString('en-ZA', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// Read next: same section first, then the rest of the issue, never itself.
const all = await getCollection('articles', (a) => isVisible(a.data));
const readNext = [
  ...all.filter((a) => a.id !== article.id && a.data.section === article.data.section),
  ...all.filter((a) => a.id !== article.id && a.data.section !== article.data.section),
].slice(0, 3);
---

<Base title={article.data.title} description={article.data.dek}>
  <div class="wrap">
    <article>
      <header class="article-head">
        {
          section && (
            <p class="eyebrow">
              <a href={`/section/${section.slug}`}>{section.name}</a>
            </p>
          )
        }
        <h1>{article.data.title}</h1>
        <p class="dek">{article.data.dek}</p>
        <span class="meta">{dateLabel} · {article.data.readingTime}</span>
        <figure class="article-hero">
          <img src={heroFor(article)} alt="" loading="eager" />
          {
            article.data.heroImage && credit && (
              <figcaption class="hero-credit">
                Photo: {credit.photographer} via <a href={credit.pageUrl} rel="noopener noreferrer">{credit.provider}</a>
              </figcaption>
            )
          }
        </figure>
        {
          article.data.moneyLineStat && (
            <MoneyLine stat={article.data.moneyLineStat} caption={article.data.moneyLineCaption} />
          )
        }
      </header>

      <div class="article-body">
        <Content />
      </div>

      {
        article.data.sources.length > 0 && (
          <footer class="article-sources">
            <p class="eyebrow plain">Sources</p>
            <ul>
              {article.data.sources.map((url) => (
                <li>
                  <a href={url} rel="noopener noreferrer">{url}</a>
                </li>
              ))}
            </ul>
            <p class="verified-note">
              Every figure in this article was checked against the sources above before
              publication.
            </p>
          </footer>
        )
      }
    </article>

    {
      readNext.length > 0 && (
        <aside class="read-next">
          <p class="rn-title">Read next</p>
          <div class="next-grid">
            {readNext.map((a) => (
              <article class="next-card">
                <a href={`/articles/${a.id}`} tabindex="-1" aria-hidden="true">
                  <img src={heroFor(a)} alt="" loading="lazy" />
                </a>
                <h3><a href={`/articles/${a.id}`}>{a.data.title}</a></h3>
                <span class="meta">{a.data.readingTime}</span>
              </article>
            ))}
          </div>
        </aside>
      )
    }
  </div>
</Base>
