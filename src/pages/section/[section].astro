---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { SECTIONS, isVisible } from '../../consts';

export async function getStaticPaths() {
  return SECTIONS.map((section) => ({
    params: { section: section.slug },
    props: { section },
  }));
}

const { section } = Astro.props;
const articles = (
  await getCollection('articles', (a) => a.data.section === section.slug && isVisible(a.data))
).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base title={section.name} description={section.description}>
  <div class="wrap section-head">
    <h1>{section.name}</h1>
    <p class="dek">{section.description}</p>
  </div>
  <div class="wrap section-list">
    {
      articles.length === 0 ? (
        <div class="empty-note">
          <p class="dek">Articles for this section are in production.</p>
        </div>
      ) : (
        <div class="card-grid">
          {articles.map((a) => (
            <ArticleCard article={a} />
          ))}
        </div>
      )
    }
  </div>
</Base>
