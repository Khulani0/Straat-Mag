---
import Base from '../layouts/Base.astro';
---

<Base title="Subscribe">
  <div class="wrap page-body">
    <p class="eyebrow">Subscribe</p>
    <h1>One email a week. Every rand accounted for.</h1>
    <p>
      Get every issue of Straat Mag in your inbox: procurement intelligence, funding deadlines,
      and verified winner stories for South African entrepreneurs. Free.
    </p>
    <!-- BEEHIIV EMBED: replace the placeholder div below with the real Beehiiv embed code. -->
    <div class="beehiiv-placeholder" id="beehiiv-embed-placeholder" style="margin-top: 1.6rem;">
      Email signup opens soon. The launch issue is in production.
    </div>
  </div>
</Base>
