# Copy this file to .env and fill in the keys you have. .env is gitignored.
# All three image services are free. You do not need all three: one is enough,
# but more keys means a wider choice of photos.

# Pexels: sign up at https://www.pexels.com/api/ , copy your API key.
PEXELS_API_KEY=

# Pixabay: sign up at https://pixabay.com/api/docs/ , copy your key.
PIXABAY_API_KEY=

# Unsplash: create an app at https://unsplash.com/developers , copy the Access Key.
UNSPLASH_ACCESS_KEY=
